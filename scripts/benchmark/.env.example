# TopicArena benchmark — environment configuration
#
# Copy this file to `.env` (same directory) and fill in your values:
#     cp .env.example .env
#
# The `.env` file is git-ignored and never published. Values exported in your
# shell take precedence over this file. All values below are placeholders.

# --- Storage backend ---
# "local" writes results to the filesystem (no AWS needed; this is the default).
# "s3" writes to s3://$TOPICARENA_S3_BUCKET/$TOPICARENA_S3_PREFIX/ instead.
TOPICARENA_STORAGE=local
# Root directory for the local backend (default: scripts/benchmark/results/).
# TOPICARENA_LOCAL_DIR=/path/to/results

# --- S3 storage (only used when TOPICARENA_STORAGE=s3) ---
TOPICARENA_S3_BUCKET=your-bucket
TOPICARENA_S3_PREFIX=TopicArena

# --- AWS credentials / region ---
# AWS_PROFILE is optional; leave unset to use the default credential chain.
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile

# --- SageMaker (only needed to launch training jobs on SageMaker) ---
TOPICARENA_SM_ROLE_ARN=arn:aws:iam::000000000000:role/your-sagemaker-execution-role

# --- Bedrock LLM-as-judge (only needed for the LLM evaluation) ---
TOPICARENA_BEDROCK_ROLE_ARN=arn:aws:iam::000000000000:role/your-bedrock-batch-role
TOPICARENA_LLM_MODEL_ID=us.anthropic.claude-opus-4-6-v1
# Cross-account Bedrock (optional): set these only if Bedrock runs in a different
# AWS account than the S3 bucket. Leave unset for a single-account setup.
# TOPICARENA_BEDROCK_PROFILE=your-bedrock-account-profile
# TOPICARENA_S3_BUCKET_OWNER=000000000000
